{
  "id":"cloud-volume-hygiene","version":"1","intent_instructions":"Select quarantine_volume only for a recoverable registered-volume quarantine proposal; otherwise unknown.",
  "intents":{"quarantine_volume":{"description":"Propose quarantine after verified recovery evidence","type_iri":"urn:agent-calculus:cloud-volume-hygiene:QuarantineRequest","required_slots":["account","environment","operation","region","retention_days","snapshot","volume"],"action":"propose_volume_quarantine"}},
  "slots":{
    "account":{"description":"authorized cloud account","predicate_iri":"urn:agent-calculus:cloud-volume-hygiene:account"},"environment":{"description":"account environment","predicate_iri":"urn:agent-calculus:cloud-volume-hygiene:environment"},"operation":{"description":"recoverable hygiene operation","predicate_iri":"urn:agent-calculus:cloud-volume-hygiene:operation"},"region":{"description":"cloud region","predicate_iri":"urn:agent-calculus:cloud-volume-hygiene:region"},"retention_days":{"description":"quarantine retention days","predicate_iri":"urn:agent-calculus:cloud-volume-hygiene:retentionDays"},"snapshot":{"description":"verified recovery snapshot","predicate_iri":"urn:agent-calculus:cloud-volume-hygiene:snapshot"},"volume":{"description":"managed block volume","predicate_iri":"urn:agent-calculus:cloud-volume-hygiene:volume"}
  },
  "actions":{"propose_volume_quarantine":{"description":"Propose a recoverable quarantine without calling cloud APIs","action_iri":"urn:agent-calculus:cloud-volume-hygiene:propose-volume-quarantine","capability_class_iri":"urn:agent-calculus:cloud-volume-hygiene:DeletionQuarantineProposal"}},
  "harvest_rules":[
    {"kind":"reject","id":"reject-destructive-cloud-action","pattern":"(?i)\\b(?:delete\\s+.*\\s+immediately|without\\s+(?:a\\s+)?snapshot|disable\\s+KMS|bypass\\s+retention)\\b","code":"destructive_cloud_action"},
    {"kind":"closed_lookup","id":"volume-registry","slot":"volume","pattern":"(?i)\\b(?P<value>vol-[0-9a-f]{17})\\b","capture":"value","values":{"vol-0abc1234def567890":{"type":"iri","value":"urn:agent-calculus:cloud-volume-hygiene:vol-0abc1234def567890"}},"rejection_code":"unsupported_volume"},
    {"kind":"closed_lookup","id":"account-registry","slot":"account","pattern":"\\b(?P<value>[0-9]{12})\\b","capture":"value","values":{"123456789012":{"type":"iri","value":"urn:agent-calculus:cloud-volume-hygiene:account-123456789012"}},"rejection_code":"unsupported_account"},
    {"kind":"closed_lookup","id":"region-registry","slot":"region","pattern":"(?i)\\b(?P<value>us-west-2)\\b","capture":"value","values":{"us-west-2":{"type":"iri","value":"urn:agent-calculus:cloud-volume-hygiene:us-west-2"}},"rejection_code":"unsupported_region"},
    {"kind":"closed_lookup","id":"snapshot-registry","slot":"snapshot","pattern":"(?i)\\b(?P<value>snap-[0-9a-f]{17})\\b","capture":"value","values":{"snap-0123456789abcdef0":{"type":"iri","value":"urn:agent-calculus:cloud-volume-hygiene:snap-0123456789abcdef0"}},"rejection_code":"unsupported_snapshot"},
    {"kind":"alias","id":"environment-production","slot":"environment","aliases":["production"],"value":{"type":"iri","value":"urn:agent-calculus:cloud-volume-hygiene:production"},"whole_word":true},
    {"kind":"alias","id":"operation-quarantine","slot":"operation","aliases":["quarantine for deletion"],"value":{"type":"iri","value":"urn:agent-calculus:cloud-volume-hygiene:quarantine-for-deletion"},"whole_word":true},
    {"kind":"alias","id":"retention-thirty","slot":"retention_days","aliases":["30 day retention"],"value":{"type":"integer","value":30},"whole_word":true}
  ],
  "lexical_coverage":{"rejection_code":"unmatched_lexical_input","allowlisted_ignores":[{"id":"cloud-connectives","pattern":"(?i)\\b(?:review|volume|in|account|use|snapshot|and|with)\\b"}]},
  "prompts":{"initial":{"id":"cloud.initial","text":"Which managed volume should be reviewed?"},"ambiguous":{"id":"cloud.ambiguous","text":"Choose one registered candidate."},"out_of_domain":{"id":"cloud.out","text":"That request is outside volume hygiene."},"rejected":{"id":"cloud.rejected","text":"The request was rejected before any cloud mutation."},"missing_slots":{
    "account":{"id":"cloud.account.required","text":"Provide account."},"environment":{"id":"cloud.environment.required","text":"Provide environment."},"operation":{"id":"cloud.operation.required","text":"Choose quarantine."},"region":{"id":"cloud.region.required","text":"Provide region."},"retention_days":{"id":"cloud.retention.required","text":"Choose retention."},"snapshot":{"id":"cloud.snapshot.required","text":"Provide snapshot."},"volume":{"id":"cloud.volume.required","text":"Provide volume."}
  }}
}
