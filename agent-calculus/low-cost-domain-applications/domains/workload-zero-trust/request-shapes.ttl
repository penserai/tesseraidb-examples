@prefix : <urn:agent-calculus:workload-zero-trust:> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:GrantRequestShape a sh:NodeShape ; sh:targetClass :GrantRequest ; sh:closed true ; sh:ignoredProperties ( rdf:type ) ;
  sh:property [ sh:path :target ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:hasValue :stock-api ] ;
  sh:property [ sh:path :environment ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:hasValue :production ] ;
  sh:property [ sh:path :region ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:hasValue :us-east-1 ] ;
  sh:property [ sh:path :method ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:hasValue :http-get ] ;
  sh:property [ sh:path :endpoint ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:hasValue :availability-endpoint ] ;
  sh:property [ sh:path :durationMinutes ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:hasValue 10 ] .
