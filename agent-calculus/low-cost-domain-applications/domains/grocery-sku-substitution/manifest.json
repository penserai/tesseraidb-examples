{
  "id":"grocery-sku-substitution","version":"1","intent_instructions":"Select substitute_sku only for a registered consent-, allergen-, price-, and package-safe substitution proposal; otherwise unknown.",
  "intents":{"substitute_sku":{"description":"Propose a customer-safe SKU substitution","type_iri":"urn:agent-calculus:grocery-sku-substitution:SubstitutionRequest","required_slots":["certification","max_delta_cents","order_line","package_unit","preference","quantity","requested_sku","store","substitute_sku"],"action":"propose_sku_substitution"}},
  "slots":{
    "certification":{"description":"required dietary certification","predicate_iri":"urn:agent-calculus:grocery-sku-substitution:certification"},"max_delta_cents":{"description":"customer price-delta cap","predicate_iri":"urn:agent-calculus:grocery-sku-substitution:maxDeltaCents"},"order_line":{"description":"active order line","predicate_iri":"urn:agent-calculus:grocery-sku-substitution:orderLine"},"package_unit":{"description":"compatible package unit","predicate_iri":"urn:agent-calculus:grocery-sku-substitution:packageUnit"},"preference":{"description":"active customer preference","predicate_iri":"urn:agent-calculus:grocery-sku-substitution:preference"},"quantity":{"description":"requested item count","predicate_iri":"urn:agent-calculus:grocery-sku-substitution:quantity"},"requested_sku":{"description":"out-of-stock requested SKU","predicate_iri":"urn:agent-calculus:grocery-sku-substitution:requestedSku"},"store":{"description":"fulfillment store","predicate_iri":"urn:agent-calculus:grocery-sku-substitution:store"},"substitute_sku":{"description":"approved substitute SKU","predicate_iri":"urn:agent-calculus:grocery-sku-substitution:substituteSku"}
  },
  "actions":{"propose_sku_substitution":{"description":"Propose a substitution without editing the order","action_iri":"urn:agent-calculus:grocery-sku-substitution:propose-sku-substitution","capability_class_iri":"urn:agent-calculus:grocery-sku-substitution:SubstitutionProposal"}},
  "harvest_rules":[
    {"kind":"reject","id":"reject-substitution-override","pattern":"(?i)\\b(?:ignore\\s+(?:the\\s+)?(?:peanut|milk|allergy|allergen)|without\\s+consent|force\\s+substitution|remove\\s+(?:the\\s+)?restriction)\\b","code":"unsafe_substitution_override"},
    {"kind":"closed_lookup","id":"substitute-sku-registry","slot":"substitute_sku","pattern":"(?i)\\bpropose\\s+(?P<value>SKU-[0-9]{4})\\b","capture":"value","values":{"SKU-2007":{"type":"iri","value":"urn:agent-calculus:grocery-sku-substitution:sku-2007"}},"rejection_code":"unsupported_substitute_sku"},
    {"kind":"closed_lookup","id":"requested-sku-registry","slot":"requested_sku","pattern":"(?i)\\bfor\\s+(?P<value>SKU-[0-9]{4})\\b","capture":"value","values":{"SKU-1001":{"type":"iri","value":"urn:agent-calculus:grocery-sku-substitution:sku-1001"}},"rejection_code":"unsupported_requested_sku"},
    {"kind":"closed_lookup","id":"line-registry","slot":"order_line","pattern":"(?i)\\b(?P<value>LINE-[0-9]{2})\\b","capture":"value","values":{"LINE-73":{"type":"iri","value":"urn:agent-calculus:grocery-sku-substitution:line-73"}},"rejection_code":"unsupported_order_line"},
    {"kind":"closed_lookup","id":"store-registry","slot":"store","pattern":"(?i)\\b(?P<value>STORE-[0-9]{2})\\b","capture":"value","values":{"STORE-12":{"type":"iri","value":"urn:agent-calculus:grocery-sku-substitution:store-12"}},"rejection_code":"unsupported_store"},
    {"kind":"closed_lookup","id":"preference-registry","slot":"preference","pattern":"(?i)\\b(?P<value>PREF-[0-9]{2})\\b","capture":"value","values":{"PREF-77":{"type":"iri","value":"urn:agent-calculus:grocery-sku-substitution:pref-77"}},"rejection_code":"unsupported_preference"},
    {"kind":"alias","id":"cert-vegan","slot":"certification","aliases":["vegan certified"],"value":{"type":"iri","value":"urn:agent-calculus:grocery-sku-substitution:vegan-certified"},"whole_word":true},
    {"kind":"alias","id":"unit-carton","slot":"package_unit","aliases":["carton"],"value":{"type":"iri","value":"urn:agent-calculus:grocery-sku-substitution:carton"},"whole_word":true},
    {"kind":"alias","id":"quantity-two","slot":"quantity","aliases":["quantity 2"],"value":{"type":"integer","value":2},"whole_word":true},
    {"kind":"alias","id":"delta-cap","slot":"max_delta_cents","aliases":["100 cent cap"],"value":{"type":"integer","value":100},"whole_word":true}
  ],
  "lexical_coverage":{"rejection_code":"unmatched_lexical_input","allowlisted_ignores":[{"id":"grocery-connectives","pattern":"(?i)\\b(?:propose|for|on|at|use|with)\\b"}]},
  "prompts":{"initial":{"id":"grocery.initial","text":"Which order line and SKUs?"},"ambiguous":{"id":"grocery.ambiguous","text":"Choose one registered candidate."},"out_of_domain":{"id":"grocery.out","text":"That request is outside SKU substitution."},"rejected":{"id":"grocery.rejected","text":"The request was rejected without changing the order."},"missing_slots":{
    "certification":{"id":"grocery.cert.required","text":"Provide certification."},"max_delta_cents":{"id":"grocery.cap.required","text":"Provide price cap."},"order_line":{"id":"grocery.line.required","text":"Provide order line."},"package_unit":{"id":"grocery.unit.required","text":"Provide package unit."},"preference":{"id":"grocery.preference.required","text":"Provide preference."},"quantity":{"id":"grocery.quantity.required","text":"Provide quantity."},"requested_sku":{"id":"grocery.requested.required","text":"Provide requested SKU."},"store":{"id":"grocery.store.required","text":"Provide store."},"substitute_sku":{"id":"grocery.substitute.required","text":"Provide substitute SKU."}
  }}
}
