@prefix : <urn:agent-calculus:grocery-sku-substitution:> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:SubstitutionRequestShape a sh:NodeShape ; sh:targetClass :SubstitutionRequest ; sh:closed true ; sh:ignoredProperties ( rdf:type ) ;
  sh:property [ sh:path :substituteSku ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:hasValue :sku-2007 ] ;
  sh:property [ sh:path :requestedSku ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:hasValue :sku-1001 ] ;
  sh:property [ sh:path :orderLine ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:hasValue :line-73 ] ;
  sh:property [ sh:path :store ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:hasValue :store-12 ] ;
  sh:property [ sh:path :preference ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:hasValue :pref-77 ] ;
  sh:property [ sh:path :certification ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:hasValue :vegan-certified ] ;
  sh:property [ sh:path :packageUnit ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:hasValue :carton ] ;
  sh:property [ sh:path :quantity ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:hasValue 2 ] ;
  sh:property [ sh:path :maxDeltaCents ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:hasValue 100 ] .
