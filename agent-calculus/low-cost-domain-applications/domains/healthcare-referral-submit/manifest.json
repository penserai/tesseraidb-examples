{
  "id":"healthcare-referral-submit","version":"1","intent_instructions":"Select submit_referral when the utterance asks to submit or route an existing registered referral, patient, encounter, and signed order. A later turn may supply payer and routing slots; incompleteness alone is not unknown. Clinical diagnosis or treatment is unknown. Otherwise select unknown.",
  "intents":{"submit_referral":{"description":"Administratively submit an existing referral backed by a patient encounter and signed order","type_iri":"urn:agent-calculus:healthcare-referral-submit:ReferralRequest","required_slots":["authorization","consent","coverage","encounter","facility","network_status","order","patient","payer","referral","specialty","urgency"],"action":"prepare_referral_submission"}},
  "slots":{
    "authorization":{"description":"valid prior authorization","predicate_iri":"urn:agent-calculus:healthcare-referral-submit:authorization"},"consent":{"description":"active referral consent","predicate_iri":"urn:agent-calculus:healthcare-referral-submit:consent"},"coverage":{"description":"active coverage record","predicate_iri":"urn:agent-calculus:healthcare-referral-submit:coverage"},"encounter":{"description":"active encounter","predicate_iri":"urn:agent-calculus:healthcare-referral-submit:encounter"},"facility":{"description":"accepting facility","predicate_iri":"urn:agent-calculus:healthcare-referral-submit:facility"},"network_status":{"description":"payer network status","predicate_iri":"urn:agent-calculus:healthcare-referral-submit:networkStatus"},"order":{"description":"signed referral order","predicate_iri":"urn:agent-calculus:healthcare-referral-submit:order"},"patient":{"description":"pseudonymous patient","predicate_iri":"urn:agent-calculus:healthcare-referral-submit:patient"},"payer":{"description":"active payer","predicate_iri":"urn:agent-calculus:healthcare-referral-submit:payer"},"referral":{"description":"active referral","predicate_iri":"urn:agent-calculus:healthcare-referral-submit:referral"},"specialty":{"description":"ordered specialty","predicate_iri":"urn:agent-calculus:healthcare-referral-submit:specialty"},"urgency":{"description":"order-authored urgency","predicate_iri":"urn:agent-calculus:healthcare-referral-submit:urgency"}
  },
  "actions":{"prepare_referral_submission":{"description":"Prepare a simulation-only administrative referral proposal","action_iri":"urn:agent-calculus:healthcare-referral-submit:prepare-referral-submission","capability_class_iri":"urn:agent-calculus:healthcare-referral-submit:AdministrativeReferralProposal"}},
  "harvest_rules":[
    {"kind":"reject","id":"reject-clinical-care","pattern":"(?i)\\b(?:diagnose|prescribe|medication|emergency|chest pain|stroke symptoms|suicidal)\\b","code":"clinical_care_out_of_scope"},
    {"kind":"closed_lookup","id":"patient-registry","slot":"patient","pattern":"(?i)\\b(?P<value>PAT-[0-9]{3})\\b","capture":"value","values":{"PAT-204":{"type":"iri","value":"urn:agent-calculus:healthcare-referral-submit:pat-204"}},"rejection_code":"unsupported_patient"},
    {"kind":"closed_lookup","id":"encounter-registry","slot":"encounter","pattern":"(?i)\\b(?P<value>ENC-[0-9]{3})\\b","capture":"value","values":{"ENC-778":{"type":"iri","value":"urn:agent-calculus:healthcare-referral-submit:enc-778"}},"rejection_code":"unsupported_encounter"},
    {"kind":"closed_lookup","id":"referral-registry","slot":"referral","pattern":"(?i)\\b(?P<value>REF-[0-9]{3})\\b","capture":"value","values":{"REF-551":{"type":"iri","value":"urn:agent-calculus:healthcare-referral-submit:ref-551"}},"rejection_code":"unsupported_referral"},
    {"kind":"closed_lookup","id":"order-registry","slot":"order","pattern":"(?i)\\b(?P<value>ORD-[0-9]{3})\\b","capture":"value","values":{"ORD-912":{"type":"iri","value":"urn:agent-calculus:healthcare-referral-submit:ord-912"}},"rejection_code":"unsupported_order"},
    {"kind":"closed_lookup","id":"facility-registry","slot":"facility","pattern":"(?i)\\b(?P<value>FAC-[0-9]{2})\\b","capture":"value","values":{"FAC-21":{"type":"iri","value":"urn:agent-calculus:healthcare-referral-submit:fac-21"}},"rejection_code":"unsupported_facility"},
    {"kind":"closed_lookup","id":"payer-registry","slot":"payer","pattern":"(?i)\\b(?P<value>PAYER-[0-9])\\b","capture":"value","values":{"PAYER-8":{"type":"iri","value":"urn:agent-calculus:healthcare-referral-submit:payer-8"}},"rejection_code":"unsupported_payer"},
    {"kind":"closed_lookup","id":"consent-registry","slot":"consent","pattern":"(?i)\\b(?P<value>CONSENT-[0-9]{2})\\b","capture":"value","values":{"CONSENT-88":{"type":"iri","value":"urn:agent-calculus:healthcare-referral-submit:consent-88"}},"rejection_code":"unsupported_consent"},
    {"kind":"closed_lookup","id":"coverage-registry","slot":"coverage","pattern":"(?i)\\b(?P<value>COV-[0-9]{4})\\b","capture":"value","values":{"COV-2026":{"type":"iri","value":"urn:agent-calculus:healthcare-referral-submit:cov-2026"}},"rejection_code":"unsupported_coverage"},
    {"kind":"closed_lookup","id":"authorization-registry","slot":"authorization","pattern":"(?i)\\b(?P<value>AUTH-[0-9]{3})\\b","capture":"value","values":{"AUTH-440":{"type":"iri","value":"urn:agent-calculus:healthcare-referral-submit:auth-440"}},"rejection_code":"unsupported_authorization"},
    {"kind":"alias","id":"urgency-routine","slot":"urgency","aliases":["routine"],"value":{"type":"iri","value":"urn:agent-calculus:healthcare-referral-submit:routine"},"whole_word":true},
    {"kind":"alias","id":"specialty-cardiology","slot":"specialty","aliases":["cardiology"],"value":{"type":"iri","value":"urn:agent-calculus:healthcare-referral-submit:cardiology"},"whole_word":true},
    {"kind":"alias","id":"network-in","slot":"network_status","aliases":["in network"],"value":{"type":"iri","value":"urn:agent-calculus:healthcare-referral-submit:in-network"},"whole_word":true}
  ],
  "lexical_coverage":{"rejection_code":"unmatched_lexical_input","allowlisted_ignores":[{"id":"referral-connectives","pattern":"(?i)\\b(?:submit|referral|for|patient|from|encounter|and|order|route|to|under|using)\\b"}]},
  "prompts":{"initial":{"id":"referral.initial","text":"Which existing referral should be routed?"},"ambiguous":{"id":"referral.ambiguous","text":"Choose one registered candidate."},"out_of_domain":{"id":"referral.out","text":"That request is outside administrative referrals."},"rejected":{"id":"referral.rejected","text":"Clinical-care requests are outside this capability."},"missing_slots":{
    "authorization":{"id":"referral.authorization.required","text":"Provide prior authorization."},"consent":{"id":"referral.consent.required","text":"Provide consent."},"coverage":{"id":"referral.coverage.required","text":"Provide coverage."},"encounter":{"id":"referral.encounter.required","text":"Provide encounter."},"facility":{"id":"referral.facility.required","text":"Provide facility."},"network_status":{"id":"referral.network.required","text":"Provide network status."},"order":{"id":"referral.order.required","text":"Provide order."},"patient":{"id":"referral.patient.required","text":"Provide patient."},"payer":{"id":"referral.payer.required","text":"Provide payer."},"referral":{"id":"referral.referral.required","text":"Provide referral."},"specialty":{"id":"referral.specialty.required","text":"Provide specialty."},"urgency":{"id":"referral.urgency.required","text":"Provide urgency."}
  }}
